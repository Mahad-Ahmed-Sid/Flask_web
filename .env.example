# Copy this file to `.env` and adjust the values for your machine.
# `.env` is git-ignored so your secrets never end up on GitHub.

# Required in production, optional in development.
SECRET_KEY=change-me-to-a-long-random-string

# Which config class to use: development | testing | production
FLASK_CONFIG=development

# Database connection string. Leave unset to use the local SQLite file.
# DATABASE_URL=postgresql://user:password@localhost:5432/products

# Host/port used by `flask run`
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=9000
FLASK_DEBUG=1

# Demo admin seeded by `flask db upgrade` / `flask seed-admin`.
# The development password below is for local use ONLY — set your own before
# deploying anywhere.
ADMIN_EMAIL=admin@inventory.local
ADMIN_DISPLAY_NAME=Inventory Admin
ADMIN_DEV_PASSWORD=ChangeMe-Admin1!

# Production only: send session cookies over HTTPS (default on). Set to 0 if
# you deliberately deploy over plain HTTP (not recommended).
# SESSION_COOKIE_SECURE=1
